{
  "expo": {
    "name": "Art Car Lights",
    "slug": "artcar-lights",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "artcarlights",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.artcar.lights",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app talks to the art car's LED controllers over Bluetooth. It never uses the internet.",
        "NSBluetoothPeripheralUsageDescription": "This app talks to the art car's LED controllers over Bluetooth. It never uses the internet.",
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.artcar.lights",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "This app talks to the art car's LED controllers over Bluetooth. It never uses the internet."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f07629b9-5f10-4acf-9beb-1b9edad7a8fe"
      }
    }
  }
}
